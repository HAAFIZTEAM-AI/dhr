# ===========================================================================
# HAAFIZ — environment template
#
# Copy to .env and fill in. NEVER commit the real .env — it is gitignored, and
# a previous version of this repo leaked its JWT secret and user database to a
# public GitHub repository. See docs/SECURITY.md.
#
# Every value marked REQUIRED has no safe default and the service refuses to
# start without it. That is deliberate: a service that boots with a missing
# secret fails silently and insecurely instead of loudly.
# ===========================================================================

# --- Backend (Express) ----------------------------------------------------
PORT=3001
NODE_ENV=development

# REQUIRED. Generate with: openssl rand -hex 64
# If this is ever leaked, rotate it AND invalidate all issued tokens.
JWT_SECRET=

# Token lifetime. Shorter is safer; 7d is a convenience/UX trade-off.
JWT_EXPIRE=7d

# SQLite path. In production prefer a managed Postgres instance.
DB_PATH=./data/haafiz.db

AI_SERVICE_URL=http://localhost:5001

# Comma-separated list of allowed browser origins. Do NOT use "*" together with
# credentials — that combination is rejected by browsers and is a security
# anti-pattern.
FRONTEND_URL=http://localhost:5173

# --- Rate limiting --------------------------------------------------------
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_WINDOW=900000
AUTH_RATE_LIMIT_MAX=20

# --- AI service (FastAPI) -------------------------------------------------
AI_PORT=5001

# REQUIRED in production. Comma-separated allowed origins for the AI service.
AI_CORS_ORIGINS=http://localhost:3001

# Origins the website analyzer may fetch. See the SSRF guard in
# ai-service/app/core/ssrf.py — leave these unset in production.
HAAFIZ_ALLOW_PRIVATE_NETWORKS=0

# Whisper model size: tiny | base | small | medium | large
# tiny is the default for latency; base is noticeably better on Urdu.
WHISPER_MODEL=tiny

# Optional: path to a trained scam classifier. Without it the service falls
# back to the keyword + rules engine (see docs/BLUEPRINT.md §6.2).
MODEL_PATH=./models/scam_detector.pkl

# --- WhatsApp channel (Cloud API) ----------------------------------------
# REQUIRED to run the WhatsApp channel. See docs/BLUEPRINT.md §4.1 — this is
# the primary delivery route and the single highest-priority integration.
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Use a PERMANENT system-user token. The 24-hour test token silently breaks
# in production and is the most common Cloud API mistake.
WHATSAPP_ACCESS_TOKEN=

# --- Internal service auth -----------------------------------------------
# REQUIRED. Shared secret between the WhatsApp channel and the backend for
# Family Shield escalation. Without it any caller could inject family alerts.
INTERNAL_API_TOKEN=
BACKEND_URL=http://localhost:3001

# --- Frontend (Vite) ------------------------------------------------------
# Public URLs only. Vite inlines these into the bundle at build time, so
# anything here is visible to every visitor — never put a secret in VITE_*.
VITE_API_URL=http://localhost:3001/api
VITE_AI_URL=http://localhost:5001
